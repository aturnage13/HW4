# Copy this file to .env (in HW4/) and fill in your own values. Never commit .env.

# Portkey gateway key used by backend/agent.py to reach the model
PORTKEY_API_KEY=your-portkey-api-key-here

# Model name routed through Portkey
OPENAI_MODEL=your-model-name-here

# Optional
# FRONTEND_URL=http://localhost:5173   # used in email confirmation links
# COOKIE_SECURE=false                  # set true when served over HTTPS
# APP_CHECK=1                          # set 0 to turn off the dev-only screenshot endpoint
